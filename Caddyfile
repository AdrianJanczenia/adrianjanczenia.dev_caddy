{
	servers {
		trusted_proxies static {$NETBIRD_PROXY_CIDRS:127.0.0.1/32}
		trusted_proxies_strict
	}
}

(static) {
	@static {
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.json
	}
	header @static Cache-Control "public, max-age=300"
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}
}

http://:80 {
	import security

	@nowww host adrianjanczenia.dev
	redir @nowww https://www.adrianjanczenia.dev{uri} 301

	@admin {
		host www.adrianjanczenia.dev
		path /admin /admin/*
	}
	handle @admin {
		encode zstd gzip
		header {
			>Referrer-Policy "no-referrer"
		}
		reverse_proxy admin-service:8084 {
			header_up X-Admin-Client-IP {client_ip}
		}
	}

	@portfolio host adrianjanczenia.dev www.adrianjanczenia.dev
	handle @portfolio {
		encode zstd gzip
		import static

		reverse_proxy frontend-service:8080
	}
	handle {
		respond 404
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_at 00:00 12:00
			roll_keep 50
			roll_keep_for 144h
		}
		format filter {
			request>uri query {
				replace token REDACTED
			}
			request>headers>Referer delete
		}
	}
}
